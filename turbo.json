{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_DIRECT_URL",
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_DIRECT_URL",
        "NEXT_PUBLIC_*"
      ]
    }
  }
}

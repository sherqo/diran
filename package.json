{
  "name": "diran-app",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "bun run build:shared && bun run build:backend && bun run build:frontend",
    "build:shared": "bun --cwd shared run build",
    "build:backend": "bun --cwd backend run build",
    "build:frontend": "bun --cwd frontend run build",
    "dev": "bun run dev:shared & bun run dev:backend & bun run dev:frontend",
    "dev:shared": "bun --cwd shared run dev",
    "dev:backend": "bun --cwd backend dev",
    "dev:frontend": "bun --cwd frontend dev",
    "clean": "rm -rf shared/dist backend/dist frontend/.next"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}

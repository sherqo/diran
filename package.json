{
  "name": "diran-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel workspaces:apps/frontend:dev workspace:backend:dev workspace:shared:dev",
    "build": "bun run frontend:build && bun run backend:build",
    "start": "bun run --parallel frontend:start backend:start"
  },
  "packageManager": "bun@1.3.0"
}

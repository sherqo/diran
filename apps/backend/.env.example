# Database
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Auth
JWT_SECRET=your-secret-key
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost
PORT=4003
APP_NAME=Diran AI
APP_VERSION=0.1.0
NODE_ENV=development

# External services
RESEND_API_KEY=re_...
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
GEMINI_API_KEY=...

# ------------------------------------------------------------------
# Hosting: backend runs on Vercel (serverless). WebSocket collaboration and
# long-lived features are removed — see API.md. Local dev loads this file
# via dotenv; on Vercel set the same vars in the dashboard instead.
# Local backend listens on :3000 — point the frontend at it with
# NEXT_PUBLIC_API_URL=http://localhost:3000/v1
# ------------------------------------------------------------------

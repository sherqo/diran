# Database
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Auth
JWT_SECRET=your-secret-key
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost
PORT=4003
APP_NAME=Diran AI
APP_VERSION=0.1.0
NODE_ENV=development

# External services
RESEND_API_KEY=re_...
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
GEMINI_API_KEY=...

# ------------------------------------------------------------------
# Vercel / Serverless feature flags — each incompatible feature has its own var
# Defaults: ON locally (true), OFF on Vercel (VERCEL=1). Set explicitly to override.
# On Vercel set all to false (recommended). On Railway/Fly keep true.
# ------------------------------------------------------------------
ENABLE_DOTENV=true            # Load .env file (false on Vercel, env injected via dashboard)
ENABLE_UNDER_PRESSURE=true    # @fastify/under-pressure memory/event-loop guard (no-op on lambda)
ENABLE_WEBSOCKET=true         # @fastify/websocket plugin (not supported on Vercel Functions)
ENABLE_COLLABORATION=true     # /v1/ws/collab route (requires ENABLE_WEBSOCKET=true)
ENABLE_GRACEFUL_SHUTDOWN=true # SIGTERM/SIGINT handlers (meaningless on lambda)

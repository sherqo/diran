# Database
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# Auth
JWT_SECRET=your-secret-key
FRONTEND_URL=http://localhost:3000
# Comma-separated list also supported, e.g. FRONTEND_URL=https://diran.sherqo.me,https://diran-web-frontend.vercel.app
PORT=3000
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_DOMAIN=@m.diran.sherqo.me
APP_NAME=Diran AI

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=diran-storage
R2_PUBLIC_URL=https://pub-....r2.dev

# AI
GEMINI_API_KEY=...

# ------------------------------------------------------------------
# Hosting: backend runs on Vercel (serverless). WebSocket collaboration and
# long-lived features are removed — see API.md. Local dev loads this file
# via dotenv; on Vercel set the same vars in the dashboard instead.
# Local backend listens on $PORT (default :3000) — point the frontend at it with
# NEXT_PUBLIC_API_URL=http://localhost:3000/v1
# ------------------------------------------------------------------

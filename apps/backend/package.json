{
    "name": "@diran/backend",
    "version": "0.1.0",
    "private": true,
    "description": "Diran AI Backend - Express.js + PostgreSQL with Prisma ORM",
    "type": "module",
    "imports": {
        "#*": "./src/*",
        "#shared/*": "@diran/shared/src/*"
    },
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "bun --watch src/server.ts",
        "dev:tsx": "tsx watch src/server.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:file": "prettier --write --ignore-unknown",
        "generate": "bunx prisma generate",
        "migrate": "bunx prisma migrate dev",
        "prisma:pull": "bunx prisma db pull",
        "prisma:push": "bunx prisma db push",
        "start": "bun run dist/server.js",
        "studio": "bunx prisma studio"
    },
    "dependencies": {
        "@diran/shared": "workspace:*",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.1.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/swagger": "^9.6.1",
        "@fastify/swagger-ui": "^5.2.3",
        "@fastify/under-pressure": "^9.0.3",
        "@fastify/websocket": "^11.2.0",
        "@prisma/client": "^6.19.0",
        "@railway/cli": "^4.11.1",
        "bcryptjs": "^3.0.3",
        "chalk": "^5.6.2",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.2",
        "fastify-type-provider-zod": "^6.1.0",
        "fractional-indexing": "^3.2.0",
        "jsonwebtoken": "^9.0.2",
        "ms": "^2.1.3",
        "resend": "^6.5.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/bun": "^1.3.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.10.1",
        "@types/ws": "^8.18.1",
        "prettier": "^3.6.2",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prisma": "^6.19.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}

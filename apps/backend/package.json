{
    "name": "@diran/backend",
    "version": "0.1.0",
    "private": true,
    "description": "Diran AI Backend - Express.js + PostgreSQL with Prisma ORM",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
        "vercel-build": "cd ../../packages/shared && bun run build && cd ../../apps/backend && bunx prisma generate && bun run build && bun run vendor-vercel-deps",
        "vendor-vercel-deps": "mkdir -p node_modules/@diran/shared node_modules/@prisma node_modules/.prisma && cp -r ../../packages/shared/dist node_modules/@diran/shared/dist && cp ../../packages/shared/package.json node_modules/@diran/shared/package.json && cp -r ../../node_modules/.prisma/. node_modules/.prisma/ && rm -rf node_modules/@prisma/client && cp -r ../../node_modules/@prisma/client node_modules/@prisma/client && echo 'vendored @diran/shared + @prisma/client for Vercel Root=apps/backend'",
        "dev": "bun --watch src/server.ts",
        "dev:tsx": "tsx watch src/server.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:file": "prettier --write --ignore-unknown",
        "generate": "bunx prisma generate",
        "migrate": "bunx prisma migrate dev",
        "prisma:pull": "bunx prisma db pull",
        "prisma:push": "bunx prisma db push",
        "start": "bun run dist/server.js",
        "studio": "bunx prisma studio"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.955.0",
        "@aws-sdk/s3-request-presigner": "^3.955.0",
        "@diran/shared": "workspace:*",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.1.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/multipart": "^9.3.0",
        "@fastify/rate-limit": "^10.3.0",
        "@prisma/client": "^6.19.0",
        "@railway/cli": "^4.11.1",
        "bcryptjs": "^3.0.3",
        "chalk": "^5.6.2",
        "dotenv": "^17.2.3",
        "fastify": "^5.6.2",
        "fastify-type-provider-zod": "^6.1.0",
        "fractional-indexing": "^3.2.0",
        "jsonwebtoken": "^9.0.2",
        "ms": "^2.1.3",
        "resend": "^6.5.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/bun": "^1.3.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.10.1",
        "prettier": "^3.6.2",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prisma": "^6.19.0",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}

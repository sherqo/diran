// docs: https://pris.ly/d/prisma-schema

// Some notes:
//  - We use Supabase as our Postgres provider.
//
//  - We use `@default(dbgenerated("gen_random_uuid()"))` for UUIDs because its postgres function
//    and works well with Supabase.
//
//  - We use `@map` to customize the names of the fields in the database
//    to write in camelCase in the Prisma schema but snake_case in the database
//
//  - We use `@db.Timestamptz(3)` for timestamps to store the timezone information
//    and to match the precision of Supabase's `now()` function — it defaults to 3 decimal places. 


// ========== Config ==========
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ========== Types ==========
// Block kinds (page, heading, paragraph, etc.)
enum BlockType {
  PAGE
  HEADING_1
  HEADING_2
  HEADING_3
  PARAGRAPH
  CODE
  TODO
}

// Roles Type
enum RoleType {
  OWNER
  ADMIN
  EDITOR
  VIEWER
  NONE // idk why? but makes sense to have a none role :)
}

enum ActorType {
  USER
  TEAM // not used yet, for future
}

enum EntityType {
  BLOCK
  TAG
}


// ==========  Schemas ==========
// --------- Actors ---------
// users, the main actor now - Oct, 2025
model User {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String  @unique
  password String
  name     String
  photo    String?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // refresh token fields
  refreshToken        String?   @map("refresh_token")
  refreshTokenExpires DateTime? @map("refresh_token_expires") @db.Timestamptz(3)

  // Password reset fields
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires") @db.Timestamptz(3)

  // email verification fields
  emailVerified Boolean      @default(false) @map("email_verified")
  otpHashed     String?      @map("otp_hashed")
  otpExpires    DateTime?    @map("otp_expires") @db.Timestamptz(3)

  @@map("users")
}

// --------- Entities ---------
// Schema for block
model Block {
  // Who are you?
  id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type BlockType

  // Self-referential relationship for hierarchical blocks
  parentId String? @map("parent_id") @db.Uuid // All has parents, except root blocks (pages)
  parent   Block?  @relation("BlockToChildren", fields: [parentId], references: [id])
  children Block[] @relation("BlockToChildren")
  order    Int // order among brothers

  content Json // content varies by block type, stored as JSON, will be checked/validated in the applicatioin 

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // FUTURE
  // Tags // many to many, more than one tag per block, more than one block per tag


  @@unique([parentId, order]) // NO two children under the same parent can have the same order
  @@index([parentId], name: "idx_blocks_parent_id") // index for querying children by parent
  @@map("blocks")
}

// Schema for permissions
model Permission {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  actorId  String   @map("actor_id") @db.Uuid // can be user, team or whatever for scalability...
  actorType ActorType

  entityId String   @map("entity_id") @db.Uuid // can be block, tags or whatever 
  entityType EntityType

  role    RoleType // what role this actor has on this entity

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([actorId, entityId]) // one permission per actor per entity
  @@map("permissions")
}

// idc about this db and never use it in this project, it's for the waitlist in the landing page
model waitlist {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

// docs: https://pris.ly/d/prisma-schema

// Some notes:
//  - We use Supabase as our Postgres provider.
//
//  - We use `@default(dbgenerated("gen_random_uuid()"))` for UUIDs because its postgres function
//    and works well with Supabase.
//
//  - We use `@map` to customize the names of the fields in the database
//    to write in camelCase in the Prisma schema but snake_case in the database
//
//  - We use `@db.Timestamptz(3)` for timestamps to store the timezone information
//    and to match the precision of Supabase's `now()` function — it defaults to 3 decimal places. 


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password  String
  name      String
  photo     String?

  // Timestamps
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  
  // refresh token fields
  refreshToken   String? @map("refresh_token")
  refreshTokenExpires DateTime? @db.Timestamptz(3) @map("refresh_token_expires")

  // Password reset fields
  resetPasswordToken   String? @map("reset_password_token")
  resetPasswordExpires DateTime? @db.Timestamptz(3) @map("reset_password_expires")

  // email verification fields
  emailVerified   Boolean  @default(false) @map("email_verified")
  otpHashed       String?  @map("otp_hashed")
  otpExpires      DateTime? @db.Timestamptz(3) @map("otp_expires")
  // emailVerifyToken String?  @map("email_verify_token")
  // emailVerifyExpires DateTime? @db.Timestamptz(3) @map("email_verify_expires")


  @@map("users")
}

// Schema for block 
model Block{
  // Who are you?
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       BlockType

  // Self-referential relationship for hierarchical blocks
  parentId   String    @db.Uuid @map("parent_id") // All has parents, even the page, its user is the parent 
  parent     Block?    @relation("BlockToChildren", fields: [parentId], references: [id])
  children   Block[]   @relation("BlockToChildren")
  order      Int       // order among brothers

  content    Json      // content varies by block type, stored as JSON, will be checked/validated in the applicatioin 

  // Timestamps
  createdAt  DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  // FUTURE
  // Tags // many to many, more than one tag per block, more than one block per tag
  // Permissions
  //

  @@map("blocks")
  @@index([parentId], name: "idx_blocks_parent_id") // index for querying children by parent
  @@unique([parentId, order]) // NO two children under the same parent can have the same order
}

// Block kinds (page, heading, paragraph, etc.)
enum BlockType {
  PAGE
  HEADING_1
  HEADING_2
  HEADING_3
  PARAGRAPH
  CODE
  TODO
}


// idc about this db and never use it in this project, it's for the waitlist in the landing page
model waitlist {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}


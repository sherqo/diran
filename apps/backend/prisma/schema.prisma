generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String       @unique
  password             String
  name                 String
  photo                String?
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshToken         String?      @map("refresh_token")
  refreshTokenExpires  DateTime?    @map("refresh_token_expires") @db.Timestamptz(3)
  resetPasswordToken   String?      @map("reset_password_token")
  resetPasswordExpires DateTime?    @map("reset_password_expires") @db.Timestamptz(3)
  emailVerified        Boolean      @default(false) @map("email_verified")
  otpHashed            String?      @map("otp_hashed")
  otpExpires           DateTime?    @map("otp_expires") @db.Timestamptz(3)
  permissions          Permission[]
  ownedTeams           Team[]       @relation("TeamOwner")
  teamMemberships      TeamMember[]

  @@map("users")
}

model Block {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        BlockType
  parentId    String?      @map("parent_id") @db.Uuid
  order       String
  content     Json
  contentText String?      @map("content_text")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent      Block?       @relation("BlockToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Block[]      @relation("BlockToChildren")
  permissions Permission[]
  publish     Publish?

  @@unique([parentId, order])
  @@index([parentId], map: "idx_blocks_parent_id")
  @@map("blocks")
}

// Simple publish - client generates slug
model Publish {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId    String   @unique @map("block_id") @db.Uuid
  slug       String   @unique
  showInFeed Boolean  @default(false) @map("show_in_feed")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  block      Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([slug], map: "idx_publish_slug")
  @@index([showInFeed], map: "idx_publish_show_in_feed")
  @@map("publish")
}

model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  blockId   String   @map("block_id") @db.Uuid
  role      RoleType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([userId, blockId])
  @@unique([teamId, blockId])
  @@index([userId], map: "idx_permissions_user_id")
  @@index([teamId], map: "idx_permissions_team_id")
  @@index([blockId], map: "idx_permissions_block_id")
  @@map("permissions")
}

model Team {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  ownerId     String       @map("owner_id") @db.Uuid
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  @@unique([teamId, userId])
  @@index([teamId], map: "idx_team_members_team_id")
  @@index([userId], map: "idx_team_members_user_id")
  @@map("team_members")
}

enum TeamRole {
  ADMIN
  MEMBER
}

model waitlist {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
}

enum BlockType {
  page
  paragraph
  heading
  quote
  bulletListItem
  numberedListItem
  checkListItem
  toggleListItem
  table
  codeBlock
  image
  video
}

enum RoleType {
  OWNER
  EDITOR
  VIEWER
  NONE
}
